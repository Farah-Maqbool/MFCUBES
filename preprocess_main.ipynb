   "source": [
    "sequence = []\n",
    "with open(\"all_analysis_data.txt\", \"r\") as f:\n",
    "    for line in f:\n",
    "        seq = line.strip().lower().split()\n",
    "        sequence.append(seq)\n",
    "\n",
    "all_apis = [api for seq in sequence for api in seq]\n",
    "\n",
    "api_counter = Counter(all_apis)\n",
    "\n",
    "print(f\"Total unique APIs: {len(api_counter)}\")\n",
    "api_counter\n"
   ]
